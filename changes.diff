-        labels.append(0)
-        data.append(generate_sample(False, length))
-        labels.append(1)
-
-    cols = [f'a_{t}' for t in range(length)] + [f'b_{t}' for t in range(length)]
-    df = pd.DataFrame(data, columns=cols)
-    df['label'] = labels
-    return df
