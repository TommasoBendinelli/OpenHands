-# ──────────────────────────────────────────────────────────────────────────────
-def _standardise(ts: np.ndarray) -> np.ndarray:
-    """Return (ts − mean) / std  – always mean 0, std 1."""
-    ts = ts - ts.mean()
-    return ts / ts.std(ddof=1)
